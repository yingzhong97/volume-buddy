<Window x:Class="VolumeBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音量助手" Width="1000" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        Deactivated="Window_Deactivated" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Window.Resources>
        <!-- 现代滑条样式 -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="28"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="TrackBg" Height="5" CornerRadius="2.5"
                                    Background="{DynamicResource SliderTrackBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{DynamicResource AccentBrush}" Height="5"
                                                        CornerRadius="2.5" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="14" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="16" Height="16" Fill="{TemplateBinding Foreground}"
                                                             Stroke="{DynamicResource CardBrush}" StrokeThickness="2.5"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 胶囊（设置里的模式选择） -->
        <Style x:Key="TabChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TabBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标按钮（静音等） -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分区卡片与标题 -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Padding" Value="6,14,6,10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="8,0,8,0"/>
        </Style>
        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Margin" Value="8,10,8,8"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Margin="0" CornerRadius="14" BorderThickness="0">
        <Border x:Name="InnerBorder" CornerRadius="14" Background="{DynamicResource BgBrush}">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="PanelOffset" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.RenderTransformOrigin>0.5,1</Border.RenderTransformOrigin>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Text="音量助手" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="20,16,0,12"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="HintText" Grid.Column="1" Text="" FontSize="11"
                               Foreground="{DynamicResource SubBrush}" VerticalAlignment="Center"
                               Margin="12,0,0,2"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,10,12,8">
                        <Button x:Name="BtnSettings" Style="{StaticResource GhostBtn}" Content="&#xE713;"
                                FontFamily="Segoe MDL2 Assets" Click="BtnSettings_Click" ToolTip="设置"/>
                        <Button x:Name="BtnClose" Style="{StaticResource GhostBtn}" Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets" Click="BtnClose_Click" ToolTip="隐藏"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="14,0,14,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.9*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 列1：输出设备 + 空间音效 -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="输出设备" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SectionDivider}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PlayDevices" Margin="4,0,4,0"/>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <TextBlock Text="空间音效" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel x:Name="SpatialChips" Margin="8,0,4,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 列2：输入设备 -->
                    <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="输入设备" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SectionDivider}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="RecDevices" Margin="4,0,4,0"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 列3：应用音量 -->
                    <Border Grid.Column="4" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock x:Name="MixHint" Text="应用音量" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SectionDivider}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="MixApps" Margin="4,0,4,0"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 设置浮层 -->
                    <Border x:Name="SettingsOverlay" Grid.ColumnSpan="5" Visibility="Collapsed"
                            CornerRadius="10" Background="{DynamicResource CardBrush}">
                        <StackPanel Margin="26,20,26,20">
                            <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/>
                            <TextBlock Text="打开方式" Foreground="{DynamicResource SubBrush}" FontSize="11"
                                       Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource TabBgBrush}" CornerRadius="8" Padding="3"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ModeTray" GroupName="mode" Content="托盘弹出"
                                                 Style="{StaticResource TabChip}" Checked="Mode_Changed"/>
                                    <RadioButton x:Name="ModeWindow" GroupName="mode" Content="独立窗口"
                                                 Style="{StaticResource TabChip}" Checked="Mode_Changed"/>
                                </StackPanel>
                            </Border>
                            <CheckBox x:Name="ChkAutoStart" Content="开机自动启动" Margin="0,16,0,0"
                                      Foreground="{DynamicResource TextBrush}" Checked="AutoStart_Changed"
                                      Unchecked="AutoStart_Changed"/>
                            <TextBlock Foreground="{DynamicResource SubBrush}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,16,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                       Text="提示：点击「隐藏」或关闭窗口会收起面板，左键点托盘图标随时呼出；要完全退出请在托盘图标右键菜单选择「退出」。"/>
                            <Button Content="返回" Margin="0,18,0,0" HorizontalAlignment="Left"
                                    Click="BtnBack_Click" Style="{StaticResource PillBtn}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
