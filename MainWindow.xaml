<Window x:Class="VolumeBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音量助手" Width="1000" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        Deactivated="Window_Deactivated" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Window.Resources>
        <!-- ============ 令牌 ============
             窗口 14 / 卡片 12 / 行 8 / 控件 7
             内容统一内缩 14，行高亮内缩 6
        -->

        <!-- 现代滑条 -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="TrackBg" Height="5" CornerRadius="2.5"
                                    Background="{DynamicResource SliderTrackBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{DynamicResource AccentBrush}" Height="5"
                                                        CornerRadius="2.5" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="20" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="14" Height="14" Fill="{TemplateBinding Foreground}"
                                                             Stroke="{DynamicResource ThumbRingBrush}" StrokeThickness="2.5"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标按钮（标题栏 / 行内静音） -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressBrush}"/>
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行内静音：字形与标题栏一致，用透明度表达静音态 -->
        <Style x:Key="MuteBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 胶囊（设置里的模式选择） -->
        <Style x:Key="TabChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次级按钮（返回） -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TabBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 勾选框 -->
        <Style x:Key="ModernCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                    BorderThickness="1.5" BorderBrush="{DynamicResource SliderTrackBrush}"
                                    Background="Transparent" VerticalAlignment="Center">
                                <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="9" Foreground="White" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ScrollThumbBrush}"
                                                        CornerRadius="3" Width="5" MinHeight="24" Margin="0,2,4,2"
                                                        HorizontalAlignment="Right"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分区卡片与标题 -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Padding" Value="0,13,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="14,0,14,0"/>
        </Style>
        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Margin" Value="14,9,14,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SubBrush}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="BodyNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="Foreground" Value="{DynamicResource SubBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Margin="0" CornerRadius="14" BorderThickness="0">
        <Border x:Name="InnerBorder" CornerRadius="14" Background="{DynamicResource BgBrush}">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="PanelOffset" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.RenderTransformOrigin>0.5,1</Border.RenderTransformOrigin>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,15,0,11">
                        <TextBlock x:Name="TitleText" Text="音量助手" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HintText" Text="" FontSize="11"
                                   Foreground="{DynamicResource SubBrush}" VerticalAlignment="Center"
                                   Margin="10,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <Button x:Name="BtnSettings" Style="{StaticResource IconBtn}" Content="&#xE713;"
                                Width="28" Height="28" Click="BtnSettings_Click" ToolTip="设置"/>
                        <Button x:Name="BtnClose" Style="{StaticResource IconBtn}" Content="&#xE8BB;"
                                Width="28" Height="28" Margin="2,0,0,0" Click="BtnClose_Click" ToolTip="隐藏"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="14,0,14,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.9*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 列1：输出设备 + 空间音效 -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="输出设备" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SectionDivider}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="6,7,6,0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PlayDevices"/>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <Border Style="{StaticResource SectionDivider}" Margin="14,0,14,0"/>
                                <TextBlock Text="空间音效" Style="{StaticResource SectionTitle}" Margin="14,11,14,0"/>
                                <WrapPanel x:Name="SpatialChips" Margin="14,7,8,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 列2：输入设备 -->
                    <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="输入设备" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SectionDivider}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="6,7,6,0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="RecDevices"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 列3：应用音量 -->
                    <Border Grid.Column="4" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock x:Name="MixHint" Text="应用音量" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SectionDivider}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="6,7,6,0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="MixApps"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 设置浮层 -->
                    <Border x:Name="SettingsOverlay" Grid.ColumnSpan="5" Visibility="Collapsed"
                            CornerRadius="12" Background="{DynamicResource CardBrush}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="SettingsScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                        <StackPanel MaxWidth="520" Margin="32,0,32,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="面板默认贴托盘弹出，也可改成常驻的独立窗口。" Margin="0,5,0,0"
                                       Style="{StaticResource BodyNote}"/>

                            <TextBlock Text="打开方式" Margin="0,24,0,7" Style="{StaticResource FieldLabel}"/>
                            <Border Background="{DynamicResource TabBgBrush}" CornerRadius="9" Padding="3"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ModeTray" GroupName="mode" Content="托盘弹出"
                                                 Style="{StaticResource TabChip}" Checked="Mode_Changed"/>
                                    <RadioButton x:Name="ModeWindow" GroupName="mode" Content="独立窗口"
                                                 Style="{StaticResource TabChip}" Checked="Mode_Changed"/>
                                </StackPanel>
                            </Border>

                            <CheckBox x:Name="ChkAutoStart" Content="开机自动启动" Margin="0,20,0,0"
                                      Style="{StaticResource ModernCheck}" Checked="AutoStart_Changed"
                                      Unchecked="AutoStart_Changed"/>

                            <TextBlock Margin="0,20,0,0" Style="{StaticResource BodyNote}"
                                       Text="点击「隐藏」或关闭面板只是收起，左键点托盘图标随时呼出；要完全退出请在托盘图标右键菜单里选择「退出」。"/>

                            <Button Content="返回" Margin="0,24,0,0" HorizontalAlignment="Left"
                                    Click="BtnBack_Click" Style="{StaticResource PillBtn}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
